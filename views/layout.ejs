<% if (String(body).trim().toLowerCase().startsWith('<!doctype')) { %><%- body %><% } else { %><!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title %></title>
<link rel="stylesheet" href="/css/global.css?v=<%= locals.assetVersion('css/global.css') %>">
<link id="theme-css" rel="stylesheet" href="/css/hachunedark20.css">
<script src="/js/dom.js"></script>
<script src="/js/alert.js?v=<%= locals.assetVersion('js/alert.js') %>"></script>
<script src="/js/csrf.js"></script>
<script src="/js/themes.js"></script>
<% styles.forEach(function (s) { %>
<link rel="stylesheet" href="<%= s %>">
<% }) %>
<link rel="stylesheet" href="/css/framed-browsing.css?v=<%= locals.assetVersion('css/framed-browsing.css') %>">
<%- head %>
</head>
<body>
<%- include('partials/header') %>
<div class="container"><main class="content<%= mod ? ' mod-page' : '' %>">
<% if (mod && locals.user && showNav) { %><%- include('mod/partials/nav') %><% } %>
<%- body %>
</main></div>
<%- include('partials/footer', { boardFooter: boardFooter }) %>
<% if (mod || locals.modControls) { %><script src="/js/mod.js?v=<%= locals.assetVersion('js/mod.js') %>"></script><script src="/js/edit-post.js?v=<%= locals.assetVersion('js/edit-post.js') %>"></script><% } %>
<script src="/js/captcha.js?v=<%= locals.assetVersion('js/captcha.js') %>"></script>
<script src="/js/thumb.js"></script>
<script src="/js/thread-watcher.js"></script>
<script src="/js/framed-browsing.js?v=<%= locals.assetVersion('js/framed-browsing.js') %>"></script>
<script src="/js/settings.js"></script>
<script>
// Options for the report dialog's category dropdown (post-menu.js reads this).
window.reportCategories = <%- JSON.stringify(locals.reportCategories || []).replace(/</g, '\\u003c') %>;
// Every board the site has, for the framed browsing sidebar (js/framed-browsing.js):
// the sidebar groups them into sections, and anything it does not recognise still shows
// up under "Other Boards".
window.frameBoards = <%- JSON.stringify((locals.allBoards || []).map((b) => ({ uri: b.boardUri, name: b.boardName || b.boardUri }))).replace(/</g, '\\u003c') %>;
// What an open thread does with a post that is deleted underneath the reader
// (`deletedPostDisplay` in the server config): `remove` or `mark`.
window.deletedPostDisplay = '<%= locals.deletedPostDisplay %>';
// How many characters of a file name the upload preview shows (see upload.js); the
// server truncates a post's file names the same way (`fileNameMaxLength`).
window.fileNameMaxLength = <%- Number(locals.fileNameMaxLength) || 30 %>;
</script>
<% if (modUser) { %>
<script>
window.modUser = true;
window.modIsGlobalMod = <%= Number(modUser.globalRole) <= 2 ? 'true' : 'false' %>;
window.modShowIp = <%= showIp ? 'true' : 'false' %>;
</script>
<% } %>
<script src="/js/post-menu.js"></script>
<script src="/js/poll-handler.js"></script>
</body>
</html>
<% } %>