<% if (String(body).trim().toLowerCase().startsWith('<!doctype')) { %><%- body %><% } else { %><!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title %></title>
<link rel="stylesheet" href="/css/global.css">
<link id="theme-css" rel="stylesheet" href="/css/hachunedark20.css">
<script src="/js/dom.js"></script>
<script src="/js/csrf.js"></script>
<script src="/js/themes.js"></script>
<% styles.forEach(function (s) { %>
<link rel="stylesheet" href="<%= s %>">
<% }) %>
<%- head %>
</head>
<body>
<%- include('partials/header') %>
<div class="container"><main class="content">
<% if (mod && locals.user && showNav) { %><%- include('mod/partials/nav') %><% } %>
<%- body %>
</main></div>
<%- include('partials/footer', { boardFooter: boardFooter }) %>
<% if (mod || locals.modControls) { %><script src="/js/mod.js"></script><% } %>
<script src="/js/thumb.js"></script>
<script src="/js/thread-watcher.js"></script>
<script src="/js/settings.js"></script>
<script>
// Options for the report dialog's category dropdown (post-menu.js reads this).
window.reportCategories = <%- JSON.stringify(locals.reportCategories || []).replace(/</g, '\\u003c') %>;
// How many characters of a file name the upload preview shows (see upload.js); the
// server truncates a post's file names the same way (`fileNameMaxLength`).
window.fileNameMaxLength = <%- Number(locals.fileNameMaxLength) || 30 %>;
</script>
<% if (modUser) { %>
<script>
window.modUser = true;
window.modIsGlobalMod = <%= Number(modUser.globalRole) <= 2 ? 'true' : 'false' %>;
window.modShowIp = <%= showIp ? 'true' : 'false' %>;
</script>
<% } %>
<script src="/js/post-menu.js"></script>
<script src="/js/poll-handler.js"></script>
</body>
</html>
<% } %>