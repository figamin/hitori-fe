<script>
  function updateTextareaValueFromURL() {
    const textarea = document.getElementById('message');
    const hash = window.location.hash;
    if (hash && hash.startsWith('#q')) {
      const id = hash.substring(2);
      textarea.value = `>>${id}\n`;
    }
  }
  window.onload = updateTextareaValueFromURL;
  window.onhashchange = updateTextareaValueFromURL;
</script>

<style>
  #postformTable {
    width: 100%;
    max-width: 380px;
    border-collapse: collapse;
    table-layout: fixed;
  }
  #postformTable .post-block {
    width: 90px;
    white-space: nowrap;
  }
  #postformTable .postform-input-cell {
    width: auto;
  }
  #postformTable input[type="text"],
  #postformTable input[type="password"],
  #postformTable select,
  #postformTable textarea {
    width: 100%;
    box-sizing: border-box;
  }
  #postformTable .new-thread-btn {
    margin-top: 4px;
  }
</style>

<table id="postformTable">
  <tbody>
    <tr>
      <td class="post-block"><label for="name">Name</label></td>
      <td class="postform-input-cell">
        <input type="text" id="name" name="name" class="input-text" placeholder="<%= anonymousName %>" />
      </td>
    </tr>
    <tr>
      <td class="post-block"><label for="option_selectbox">Options</label></td>
      <td class="postform-input-cell">
        <select name="option" id="option_selectbox" autocomplete="off">
          <option value=""></option>
          <option value="fortune">Fortune</option>
          <% if (isThread) { %>
          <option value="sage">Sage (Do not bump)</option>
          <option value="nonoko">Nonoko</option>
          <% } %>
        </select>
        <% if (isThread) { %>
        <button class="new-thread-btn" type="submit">New reply</button>
        <% } %>
      </td>
    </tr>
    <% if (!isThread) { %>
    <tr>
      <td class="post-block"><label for="subject">Subject</label></td>
      <td class="postform-input-cell">
        <input type="text" id="subject" name="subject" class="input-text" />
        <button class="new-thread-btn" type="submit">New thread</button>
      </td>
    </tr>
    <% } %>
    <tr>
      <td class="post-block">
        <label for="message">Comment</label>
      </td>
      <td class="postform-input-cell">
        <textarea id="message" name="message" class="input-text" rows="5"></textarea>
        <p class="file-info no-js" style="margin: 0;">Max comment length: <span id="charCount">0</span>/4096</p>
        <% var youtubeOk = locals.youtubeAllowed !== false; %>
        <% var pollsOk = locals.pollsAllowed !== false; %>
        <% var tegakiOk = locals.tegakiAllowed !== false; %>
        <div class="js-only comment-block-extra">
          <% if (youtubeOk || pollsOk || tegakiOk) { %>
          <select id="extra-select" class="form-select" autocomplete="off">
            <option value="">+ Add...</option>
            <% if (youtubeOk) { %><option value="youtube">YouTube</option><% } %>
            <% if (pollsOk) { %><option value="poll">Poll</option><% } %>
            <% if (tegakiOk) { %><option value="tegaki">Tegaki</option><% } %>
          </select>
          <% } %>
          <% if (youtubeOk) { %>
          <div id="youtube-details" style="display: none; padding: 5px 0;">
            <input type="text" id="youtube-url" name="youtube-url" placeholder="Paste YouTube URL here" style="width: 98%;" />
          </div>
          <% } %>
          <% if (pollsOk) { %>
          <div id="poll-details" class="poll-details" style="display: none; padding: 10px;">
            <input type="text" autocomplete="off" name="poll_question" placeholder="Poll question" style="width: 98%; margin-bottom: 5px;" />
            <div id="poll-options" data-max-options="<%= locals.maxPollOptions || 10 %>">
              <input type="text" autocomplete="off" name="poll_options[]" placeholder="Option 1" style="width: 90%; margin-bottom: 5px;" />
              <input type="text" autocomplete="off" name="poll_options[]" placeholder="Option 2" style="width: 90%; margin-bottom: 5px;" />
            </div>
            <button type="button" id="add-option" style="margin-bottom: 5px;">+ Add Option</button>
            <div style="margin-top: 5px;">
              <label>Poll duration:
                <select name="poll_duration">
                  <option value="1">1 day</option>
                  <option value="3">3 days</option>
                  <option value="7">1 week</option>
                  <option value="30">1 month</option>
                </select>
              </label>
            </div>
          </div>
          <% } %>
          <% if (tegakiOk) { %>
          <button type="button" id="tegaki-btn" title="Tegaki" class="form-button" style="display: none;">Tegaki</button>
          <% } %>
        </div>
      </td>
    </tr>
    <tr>
      <td class="post-block"><label>Emotes</label></td>
      <td class="postform-input-cell">
        <details id="emo" class="emoclass">
          <summary>Show Emotes</summary>
          <img src="/static/emotes/mikuwelcome.gif" title="mikuwelcome" class="emote" height="45">
          <img src="/static/emotes/mikuhappy.gif" title="mikuhappy" class="emote" height="45">
          <img src="/static/emotes/rinthumbs.gif" title="rinthumbs" class="emote" height="45">
          <img src="/static/emotes/rinheart.gif" title="rinheart" class="emote" height="45">
          <img src="/static/emotes/lenno.gif" title="lenno" class="emote" height="45">
          <br>
          <img src="/static/emotes/lensorry.gif" title="lensorry" class="emote" height="45">
          <img src="/static/emotes/lenthumbs.gif" title="lenthumbs" class="emote" height="45">
          <img src="/static/emotes/lenshock.gif" title="lenshock" class="emote" height="45">
          <img src="/static/emotes/lukaclap.gif" title="lukaclap" class="emote" height="45">
          <img src="/static/emotes/lukasparkle.gif" title="lukasparkle" class="emote" height="45">
          <br>
          <img src="/static/emotes/kaitocheer.gif" title="kaitocheer" class="emote" height="45">
          <img src="/static/emotes/kaitolick.gif" title="kaitolick" class="emote" height="45">
          <img src="/static/emotes/meikolol.gif" title="meikolol" class="emote" height="45">
          <img src="/static/emotes/meikojoy.gif" title="meikojoy" class="emote" height="45">
          <img src="/static/emotes/meikoangry.gif" title="meikoangry" class="emote" height="45">
          <br>
          <img src="/static/emotes/lukaspin.gif" title="lukaspin" class="emote" height="45">
          <img src="/static/emotes/yukarietto.gif" title="yukarietto" class="emote" height="45">
        </details>
      </td>
    </tr>
    <tr>
      <td class="post-block"><label for="standard-image">File</label></td>
      <td class="postform-input-cell">
        <div id="drop-zone">
          Drag files here to upload or <br />click here to select them, or paste an image
          <input type="file" id="image" name="image" accept="image/*,video/*" style="display: none;" />
        </div>
        <div id="standard-file-input">
          <input type="file" id="standard-image" name="image" accept="image/*,video/*" />
        </div>
        <div id="preview-container" style="margin-top: 10px; display: flex; gap: 10px; flex-wrap: wrap;"></div>
      </td>
    </tr>
    <tr>
      <td class="post-block"><label for="post-password">Password</label></td>
      <td class="postform-input-cell">
        <input type="password" id="post-password" name="post-password" class="input-text" /><span id="delPasswordInfo"> (for deletion)</span>
      </td>
    </tr>
  </tbody>
</table>

<script>
  document.getElementById('message').addEventListener('input', function () {
    document.getElementById('charCount').textContent = this.value.length;
  });
</script>

<script>
  // Emote picker: click an emote to insert a tag for it at the cursor in the comment box
  document.addEventListener('DOMContentLoaded', function () {
    const message = document.getElementById('message');
    document.querySelectorAll('#emo .emote').forEach(function (img) {
      img.style.cursor = 'pointer';
      img.addEventListener('click', function () {
        if (!message) return;
        const tag = '[emote:' + img.title + ']';
        const start = message.selectionStart != null ? message.selectionStart : message.value.length;
        const end = message.selectionEnd != null ? message.selectionEnd : message.value.length;
        message.value = message.value.slice(0, start) + tag + message.value.slice(end);
        message.focus();
        message.selectionStart = message.selectionEnd = start + tag.length;
      });
    });
  });
</script>

<% if (tegakiOk) { %>
<script src="/js/tegaki-post.js"></script>
<% } %>

<% if (youtubeOk || pollsOk || tegakiOk) { %>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    const extraSelect = document.getElementById('extra-select');
    const youtubeDetails = document.getElementById('youtube-details');
    const pollDetails = document.getElementById('poll-details');
    const tegakiBtn = document.getElementById('tegaki-btn');
    const fileInput = document.getElementById('image');
    const dropZone = document.getElementById('drop-zone');

    function setYoutubeMode(on) {
      if (dropZone) dropZone.style.opacity = on ? '0.5' : '1';
      if (fileInput) fileInput.disabled = on;
      if (!on) {
        const ytUrl = document.getElementById('youtube-url');
        if (ytUrl) ytUrl.value = '';
      }
    }

    if (extraSelect) {
      extraSelect.addEventListener('change', function () {
        const val = extraSelect.value;

        if (youtubeDetails) youtubeDetails.style.display = val === 'youtube' ? 'block' : 'none';
        if (pollDetails) pollDetails.style.display = val === 'poll' ? 'block' : 'none';
        setYoutubeMode(val === 'youtube');

        if (val === 'tegaki') {
          // Tegaki isn't a panel here - it stays exactly what it was before: a plain button.
          // Selecting it just fires that same button's click handler (from tegaki-post.js).
          if (tegakiBtn) tegakiBtn.click();
          extraSelect.value = '';
        }
      });
    }

    const standardFileInput = document.getElementById('standard-file-input');
    if (standardFileInput) standardFileInput.style.display = 'none';
  });
</script>
<% } %>
