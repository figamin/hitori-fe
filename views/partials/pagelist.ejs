<%
/* Shared page list, used by every paginated view:

     First | Prev | <up to five previous numbers> <current> <up to four next numbers> | Next | Last

   The current page is the highlighted `.current` number. `locals.href` is a
   function (pageNumber) => url, so each caller keeps its own URL shape, and the
   optional `locals.extra` is appended after "Last" (the board page puts its
   Catalog link there). */
const lastPage = Math.max(1, Number(locals.totalPages) || 1);
const current = Math.min(Math.max(1, Number(locals.page) || 1), lastPage);
const size = Math.min(10, lastPage);

// The window holds ten numbers (five before the current page and four after it).
// A shorter page list cannot fill it, so slots are given up from the previous
// side first, then the next, alternating - which ends with a window the size of
// the page list itself.
let before = 5;
let after = 4;
if (before + 1 + after > size) {
  let fromBefore = true;
  while (before + 1 + after > size) {
    if (fromBefore && before > 0) before -= 1;
    else if (!fromBefore && after > 0) after -= 1;
    else if (before > 0) before -= 1;
    else if (after > 0) after -= 1;
    else break;
    fromBefore = !fromBefore;
  }
}

// Slide the window inside [1, lastPage] so it always holds `size` numbers.
let first = current - before;
let last = first + size - 1;
if (first < 1) {
  first = 1;
  last = size;
}
if (last > lastPage) {
  last = lastPage;
  first = Math.max(1, lastPage - size + 1);
}

const onFirst = current <= 1;
const onLast = current >= lastPage;
%>
<div class="pagelist" data-current-page="<%= current %>" data-total-pages="<%= lastPage %>">
  <div class="page-button"><a href="<%= locals.href(1) %>"><button type="button" <%= onFirst ? 'disabled' : '' %>>First</button></a></div>
  <div class="page-button"><a href="<%= locals.href(Math.max(1, current - 1)) %>"><button type="button" <%= onFirst ? 'disabled' : '' %>>Prev</button></a></div>
  <div class="pages">
    <% for (let i = first; i <= last; i++) { %><% if (i === current) { %><span class="current"><%= i %></span> <% } else { %>[<a href="<%= locals.href(i) %>"><%= i %></a>] <% } %><% } %>
  </div>
  <div class="page-button"><a href="<%= locals.href(Math.min(lastPage, current + 1)) %>"><button type="button" <%= onLast ? 'disabled' : '' %>>Next</button></a></div>
  <div class="page-button"><a href="<%= locals.href(lastPage) %>"><button type="button" <%= onLast ? 'disabled' : '' %>>Last</button></a></div>
  <% if (locals.extra) { %><div class="pages catalog-link"><%- locals.extra %></div><% } %>
</div>
