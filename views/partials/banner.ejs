<div class="board-banner" id="banner-container">
  <div id="bannerCnt" class="title">
    <img src="/randomBanner.js" alt="Banner" class="banner-img" id="main-banner" width="400" height="100">
  </div>
  <% if (boardUri) { %>
  <div class="board-title">/<%= boardUri %>/ - <%= boardName %></div>
  <% if (boardDescription) { %><div class="board-description"><%- boardDescription %></div><% } %>
  <% } else { %>
  <div class="board-title"><%= title %></div>
  <% } %>
</div>
