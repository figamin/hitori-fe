<% var site = siteUrl || ''; %>
<% var maxW = locals.maxWidth || 235; %>
<% var maxH = locals.maxHeight || 235; %>
<% var imgClass = locals.imageClass || 'thread-image'; %>
<% var dw = file.width; var dh = file.height; var placeholderThumbs = ['/spoiler.png', '/spoiler.webp', '/genericThumb.webp', '/audioGenericThumb.webp', '/imageNotFound.webp']; if (dw && dh && placeholderThumbs.indexOf(file.thumb) === -1) { if (dw > maxW || dh > maxH) { var r = Math.min(maxW / dw, maxH / dh); dw = Math.round(dw * r); dh = Math.round(dh * r); } } else { dw = null; dh = null; } %>
<% var fileUrl = site + file.path; %>
<% var matchingReplay = null; if (file.originalName && file.originalName.endsWith('-tegaki.png') && locals.files) { matchingReplay = files.find(function(f) { return f.mime === 'tegaki/replay' && f.originalName && f.originalName.slice(0, -4) === file.originalName.slice(0, -3); }); } %>
<details open>
  <summary>
    <span class="hide-file-button"></span>
    <% if (file.mime !== 'youtube/video') { %>
    <a target="_blank" href="<%= file.path %>" class="file-link"><%= file.originalName %></a>
    - <%= (file.size / 1024).toFixed(2) %> KB
    <% if (file.width && file.height) { %>(<%= file.width %>x<%= file.height %>)<% } %>
    <a href="<%= file.path %>" download="<%= file.originalName %>" title="Download"><img src="/img/download.png" width="16" alt="Download"></a>
    <% if (file.mime === 'tegaki/replay') { %>
    <a href="<%= file.path %>" class="replay-tegaki" download="<%= file.originalName %>">Replay</a>
    <% } else if (matchingReplay) { %>
    <a href="<%= matchingReplay.path %>" class="replay-tegaki" download="<%= matchingReplay.originalName %>">Replay</a>
    <% } %>
    <% if (file.mime !== 'tegaki/replay') { %>
    <a target="_blank" style="text-decoration: underline;" title="SauceNAO" href="https://saucenao.com/search.php?url=<%= encodeURIComponent(fileUrl) %>"><img src="/img/saucenao.png" width="16" alt="SauceNAO"></a>
    <a target="_blank" style="text-decoration: underline;" title="IQDB" href="https://iqdb.org/?url=<%= encodeURIComponent(fileUrl) %>"><img src="/img/iqdb.jpg" width="16" alt="IQDB"></a>
    <a target="_blank" style="text-decoration: underline;" title="Yandex" href="https://yandex.com/images/search?rpt=imageview&url=<%= encodeURIComponent(fileUrl) %>"><img src="/img/yandex.png" width="16" alt="Yandex"></a>
    <% } %>
    <% if (modView) { %><%- include('/mod/partials/file-actions', { boardUri, threadId, postId, fileIndex }) %><% } %>
    <% } else { %>
    <a target="_blank" href="<%= file.path %>" class="file-link"><%= file.path %></a>
    <a target="_blank" style="text-decoration: underline;" title="YouTube" href="<%= file.path %>"><img src="/img/youtube.png" width="16" alt="YouTube"></a>
    <% if (modView) { %><%- include('/mod/partials/file-actions', { boardUri, threadId, postId, fileIndex }) %><% } %>
    <% } %>
  </summary>
  <% if (file.mime !== 'tegaki/replay') { %>
  <div class="image-container">
    <a href="<%= file.path %>" class="media-toggle" data-mime="<%= file.mime %>"<% if (file.width && file.height) { %> data-file-width="<%= file.width %>" data-file-height="<%= file.height %>"<% } %>>
      <img loading="lazy" src="<%= file.thumb %>" alt="<%= file.originalName %>" class="<%= imgClass %>" data-full="<%= file.path %>" data-thumb="<%= file.thumb %>"<% if (dw && dh) { %> width="<%= dw %>" height="<%= dh %>"<% } else if (file.mime === 'youtube/video') { %> width="<%= maxW %>"<% } %>>
    </a>
  </div>
  <% } %>
</details>
