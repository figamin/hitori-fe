<footer id="footer">
  <% if (boardFooter) { %>
    <nav class="board-list footer-board-list">
      [
      <% if (navBoards.length) { navBoards.forEach(function(board, i) { %>
      <a href="/<%= board.boardUri %>/"><%= board.boardUri %></a><% if (i < navBoards.length - 1) { %> /<% } %>
      <% }); } %>
      ]
    </nav>
  <% } %>
    <div class="footer-nav-tools">
      [<a href="#" class="watch-list-btn">Thread Watcher</a>]
      <% if (boardFooter) { %>
      [<a href="#" class="settings-btn">Settings</a>]
      [<a href="/mod">Moderation</a>]
      <% } %>
    </div>
    <% if (boardFooter) { %>
      <div class="footer-text">39chan is not associated with Yamaha, the Vocaloid brand or any of the contents discussed on the site.<br />All trademarks and copyrights on this page are owned by their respective parties. Images uploaded are the responsibility of the Poster. Comments are owned by the Poster.</div>
    <% } %>
    <div id="footer-links">
      <a href="/faq">FAQ</a> • <a href="/rules">Rules</a> • <a href="/news">News</a><br>
      - <a href="https://github.com/koshi-chan/koshi">hitori (koshi fork)</a> -
    </div>
</footer>
