<%# The quick reply, laid out like 4chan X's: a slim draggable title bar, the fields as
    joined boxes, the comment with its character count in the corner, the attachment (file,
    embed, poll or tegaki), the captcha, and options and Submit along the bottom. qr.js keeps it in step with the reply
    form (text, name, password, options and files are shared). %>
<div id="quickReply">
  <div id="quickReplyHeader">
    <span class="qr-title">Quick Reply</span>
    <button type="button" id="qr-close" title="Close">×</button>
  </div>
  <form
    action="/<%= boardUri %>/thread/<%= thread.threadId %>/reply"
    class="reply-form"
    method="POST"
    enctype="multipart/form-data"
    id="quick-reply-form"
    data-max-files="<%= maxUploadFiles || 3 %>"
  >
    <div class="qr-row qr-fields">
      <input type="text" id="name-qr" name="name" placeholder="<%= anonymousName || 'Anonymous' %>" title="Name" />
      <input type="text" id="post-password-qr" name="post-password" autocomplete="off" spellcheck="false" value="<%= locals.formPassword %>" placeholder="Password" title="Password (for deletion)" />
    </div>

    <div class="qr-comment">
      <textarea required id="message-qr" name="message" class="qr-textarea" placeholder="Comment"></textarea>
      <span class="qr-count" title="Max comment length: 4096"><span id="qr-charCount">0</span>/4096</span>
    </div>

    <%# File / Embed / Poll / Tegaki, mirroring the reply form's "Select" row (qr.js builds the
        links from it). The embed and poll fields are copies of the reply form's, kept in step
        with them; a poll keeps the drop zone under it, as in the reply form. %>
    <div class="qr-modes" id="qr-modes" hidden></div>
    <div class="qr-slot" id="qr-embed-slot" hidden></div>
    <div class="qr-slot" id="qr-poll-slot" hidden></div>
    <div class="qr-dropzone" id="qr-dropzone" title="Click to select files">Drop files here, click to select, or paste</div>
    <div id="qr-file-section"></div>

    <div class="captcha-cell"><%- include('captcha').trim() %></div>

    <div class="qr-row qr-bottom">
      <label title="Show a fortune on the post"><input type="checkbox" id="fortune-qr" name="fortune" value="true" />Fortune</label>
      <% if (isThread) { %>
      <label title="Do not bump the thread"><input type="checkbox" id="sage-qr" name="sage" value="true" />Sage</label>
      <label title="Go back to the board after posting"><input type="checkbox" id="nonoko-qr" name="nonoko" value="true" />Nonoko</label>
      <% } %>
      <button class="new-thread-btn" type="submit">Submit</button>
    </div>
  </form>
</div>

<style>
  #quickReply {
    background-color: var(--post-color);
    border: 1px solid var(--border-color);
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.25);
    box-sizing: border-box;
    display: none;
    font-size: 12px;
    left: calc(100vw - 326px);
    padding: 2px;
    position: fixed;
    top: 126px;
    width: 320px;
    z-index: 9;
  }

  .show-quickreply {
    display: block !important;
    height: auto !important;
  }

  #quickReplyHeader {
    align-items: center;
    cursor: move;
    display: flex;
    justify-content: space-between;
    padding: 1px 2px 3px;
    user-select: none;
  }

  #quickReplyHeader .qr-title {
    font-weight: bold;
  }

  #qr-close {
    background: none;
    border: none;
    color: var(--text-color);
    cursor: pointer;
    font-size: 16px;
    font-weight: bold;
    line-height: 1;
    padding: 0 2px;
  }

  #qr-close:hover {
    color: var(--hover-link-color);
  }

  /* The fields are joined boxes, one border between neighbours. */
  #quick-reply-form {
    display: flex;
    flex-direction: column;
    margin: 0;
  }

  #quick-reply-form .qr-row {
    align-items: center;
    display: flex;
    min-width: 0;
  }

  #quick-reply-form input[type="text"],
  #quick-reply-form .qr-textarea {
    background: var(--input);
    border: 1px solid var(--border-color);
    border-radius: 0;
    box-sizing: border-box;
    color: var(--text-color);
    font: 12px Arial, sans-serif;
    margin: 0;
    min-width: 0;
    padding: 2px 4px;
  }

  #quick-reply-form .qr-fields input {
    flex: 1 1 0;
    height: 22px;
  }

  #quick-reply-form .qr-fields input + input {
    border-left: none;
  }

  #quick-reply-form .qr-comment {
    position: relative;
  }

  #quick-reply-form .qr-textarea {
    border-top: none;
    display: block;
    height: 120px;
    min-height: 60px;
    resize: vertical;
    width: 100%;
  }

  #quick-reply-form .qr-count {
    bottom: 3px;
    color: var(--text-color);
    font-size: 10px;
    opacity: 0.5;
    pointer-events: none;
    position: absolute;
    right: 16px;
  }

  #quick-reply-form .captcha-cell:not(:empty) {
    margin-top: 3px;
    text-align: center;
  }

  #quick-reply-form .captcha-cell .captcha-controls {
    justify-content: center;
  }

  #quick-reply-form .captcha-cell .captcha-image {
    margin-left: auto;
    margin-right: auto;
  }

  #quick-reply-form .captcha-cell:empty {
    display: none;
  }

  /* The selected files, as small cards (with their spoiler/NSFW choice). */
  #qr-file-section .preview-container,
  #qr-file-section #qr-preview-container {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-top: 3px !important;
  }

  #qr-file-section #qr-preview-container:empty {
    display: none;
  }

  #qr-file-section .preview-item {
    font-size: 10px;
    max-width: 100%;
  }

  #qr-file-section .preview-item img,
  #qr-file-section .preview-item video {
    max-height: 60px;
    max-width: 90px;
  }

  #quickReply.qr-dragover {
    outline: 2px dashed var(--link-color);
  }

  /* File / Embed / Poll / Tegaki */
  #quick-reply-form .qr-modes {
    font-size: 11px;
    margin-top: 3px;
    text-align: center;
  }

  #quick-reply-form .qr-modes[hidden] {
    display: none;
  }

  #quick-reply-form .qr-mode {
    color: var(--link-color);
    cursor: pointer;
    text-decoration: underline;
  }

  #quick-reply-form .qr-mode.active {
    color: var(--text-color);
    font-weight: bold;
    text-decoration: none;
  }

  #quick-reply-form .qr-dropzone {
    border: 1px dashed var(--border-color);
    cursor: pointer;
    font-size: 11px;
    margin-top: 3px;
    opacity: 0.75;
    padding: 8px 4px;
    text-align: center;
  }

  #quick-reply-form .qr-dropzone:hover,
  #quickReply.qr-dragover .qr-dropzone {
    opacity: 1;
  }

  #quick-reply-form .qr-dropzone[hidden] {
    display: none;
  }

  /* The copies of the reply form's embed and poll fields. */
  #quick-reply-form .qr-slot:empty,
  #quick-reply-form .qr-slot[hidden] {
    display: none;
  }

  #quick-reply-form .qr-slot {
    margin-top: 3px;
  }

  #quick-reply-form .qr-slot #poll-details-qr {
    padding: 0 !important;
  }

  #quick-reply-form .qr-slot input[type="text"] {
    width: 100% !important;
  }

  #quick-reply-form .qr-bottom {
    gap: 6px;
    margin-top: 3px;
  }

  #quick-reply-form .qr-bottom label {
    align-items: center;
    display: inline-flex;
    font-size: 11px;
    gap: 2px;
    white-space: nowrap;
  }

  #quick-reply-form .qr-bottom input[type="checkbox"] {
    margin: 0;
  }

  #quick-reply-form .qr-bottom .new-thread-btn {
    margin-left: auto;
    min-width: 75px;
  }
</style>

<script src="/js/qr.js?v=<%= locals.assetVersion('js/qr.js') %>"></script>
