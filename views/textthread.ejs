<% boardFooter = true; %>
<% title = '/' + boardUri + '/ - ' + (thread.subject || thread.message); %>
<% styles = ['/css/textboard.css', '/css/tegaki.css', 'https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/styles/monokai-sublime.min.css']; %>
<% if (modView) { %>
        <%- include('/mod/partials/thread-toolbar', { user, roleLabel, boardUri, thread }) %>
        <% } %>
        <div style="padding: 5px;padding-bottom: 0px;">
        <a class="small-button" href="/<%= boardUri %>/"><%= boardName %></a>
        <a class="small-button" href="#footer">▼</a>
        </div>
        <hr>
        <%- include('partials/announcement') %>
        <% if (boardMessage) { %>
        <hr>
        <div style="text-align: center">
        <%- boardMessage %>
        </div>
        <% } %>
        <hr>
        <div class="threads">
          <article class="thread" id="<%= thread.threadId %>">
            <div class="textthreadpage"><h2><a href="/<%= boardUri %>/thread/<%= thread.threadId %>"><%- thread.subject || 'No title' %> (<%= thread.postCount || 1 %>)</a></h2></div>
            <%- include('cells/textop', { thread, boardUri, replyNumber: 1, modView, showIp, globalStaff }) %>
            <div class="textreplies" style="border: none" id="replies">
              <% posts.forEach((post, index) => { %>
              <%- include('cells/textreply', { reply: post, thread, boardUri, replyNumber: index + 2, modView, showIp, globalStaff }) %>
              <% }) %>
            </div>
          </article>
        </div>
        <div class="page-nav">
          <a class="small-button" href="/<%= boardUri %>/"><%= boardName %></a>
          <a class="small-button" href="#">▲</a>
          <span>
            There are
            <%= thread.totalReplies + 1 %>
            posts made by
            <%= thread.uniquePosters %>
            people.
          </span>
        </div>
        <% if (!modView) { %>
        <div class="page-content">
          <div class="reply-form-container">
            <% if (thread.locked) { %>
            <h3 style="margin-top: 0">This Thread is locked and you cannot reply.</h3>
            <img src="/img/lock.webp" width="330" />
            <% } else { %>
            <form
              action="/<%= boardUri %>/thread/<%= thread.threadId %>/reply"
              class="reply-form"
              id="reply-form"
              method="POST"
              enctype="multipart/form-data"
              data-max-files="<%= maxUploadFiles %>">
              <%- include('partials/post-form') %>
            </form>
            <noscript>
              <a href="/styling">Styling</a>
            </noscript>
            <% } %>
          </div>
          <span>
            <span id="countdown" class="thread-refresh-controls">
              <input type="button" id="thread-refresh-btn" value="Refresh">
              <label><input type="checkbox" id="thread-auto-refresh" checked> Auto <span id="thread-refresh-label"></span></label>
            </span>
            <form id="delete-form" action="/api/delete-posts" method="POST" style="float: right;margin-bottom: 10px;margin-right: 10px;">
              Delete post: 
              <input type="password" id="delete-password" name="password" style="width: 50px;">
              <button type="submit">Delete</button>
            </form>
            </span>
        </div>
        <% } %>
        <% if (modView) { %>
        <%- include('/mod/partials/panels') %>
        <% } %>
<% if (!modView) { %>
<%- include('partials/quick-reply') %>
<% } %>

<script src="/js/thread.js?v=<%= locals.assetVersion('js/thread.js') %>"></script>
<script src="/js/quote.js?v=<%= locals.assetVersion('js/quote.js') %>"></script>
<script src="/js/post-inline.js?v=<%= locals.assetVersion('js/post-inline.js') %>"></script>
<script src="/js/delete-form.js"></script>
<script src="/js/you.js"></script>
<script src="/js/upload.js"></script>
<% if (modView) { %>
<script>
  window.modBoardUri = '<%= boardUri %>';
  window.modThreadId = <%= thread.threadId %>;
</script>
<script src="/js/mod.js?v=<%= locals.assetVersion('js/mod.js') %>"></script>
<script src="/js/edit-post.js?v=<%= locals.assetVersion('js/edit-post.js') %>"></script>
<% } %>
