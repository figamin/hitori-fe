<% boardFooter = true; %>
<% title = '/all/ - Latest Posts'; %>
<% head = '<link rel="alternate" type="application/rss+xml" title="' + siteName + ' | Overboard" href="/rss.xml" />'; %>
<%- include('partials/banner', { title: 'Latest Posts', boardUri: false }) %>
<div class="board-top"><a href="/rss.xml" title="RSS" class="feed-link"><img src="/img/feed.svg" alt="RSS" width="16" height="16" class="feed-icon"></a></div>
<%- include('partials/announcement') %>
<div class="threads"><%- include('cells/thread-list', { threads: threads, boardUri: boardUri }) %></div>
<div id="loading" style="text-align: center; display: none">
  <p>Loading more threads...</p>
</div>
<% function pageHref(i) { return i === 1 ? '/all/' : '/all/?page=' + i; } %>
<%- include('partials/pagelist', { page: currentPage, totalPages, href: pageHref }) %>

<script src="/js/markdown-btn.js"></script>
<script src="/js/expansion.js"></script>
<script src="/js/quote.js"></script>
<script src="/js/hide.js"></script>
