<div class="reply"
data-post-id="<%= reply.postId %>"
data-thread-id="<%= thread.threadId %>"
data-board="<%= boardUri %>"
<% if (locals.replyNumber != null) { %>data-reply-number="<%= replyNumber %>"<% } %>>
  <div class="post-info">
    <% if (locals.replyNumber != null) { %><span class="reply-number" title="Reply #<%= replyNumber %>"><%= replyNumber %></span> <% } %><% if (!modView) { %><span class="post-quote">&gt;&gt;</span> <% } %>
    <% if (!locals.isSearchResult) { %><input type="checkbox" class="<%= modView ? 'mod-select' : 'post-checkbox' %>" <% if (modView) { %>value="<%= boardUri %>-<%= thread.threadId %>-<%= reply.postId %>"<% } else { %>name="posts" form="delete-form" value="<%= reply.postId %>-false"<% } %>><% } %>
    Name:
    <% if (reply.signedRole === "Admin") { %>
      <span title="This user is the site administrator" class="admin-name"><a target="_blank" href="https://syrno.net">syrno<span style="font-weight: normal;">!!zmOAdD</span></a> ## Admin <img src="/img/admin.png"></span>
      <% } else if (reply.signedRole === "Global volunteer" || reply.signedRole === "Global Volunteer" || reply.signedRole === "Global Moderator" || reply.signedRole === "Moderator") { %>
        <span title="This user is a site moderator" class="mod-name"><%- reply.name %> ## Moderator <img src="/img/modicon.gif"></span>
      <% } else { %>
        <span class="name" data-post-id="<%= reply.postId %>" data-board="<%= boardUri %>" data-thread-id="<%= thread.threadId %>"><%- reply.name %></span>
      <%}%>
      <%- include('../partials/time', { date: reply.creation }) %>
    <a class="linkQuote" title="Link to this post" href="/<%= boardUri %>/<%= locals.isArchive ? 'archive/' : '' %>thread/<%= thread.threadId %>#<%= reply.postId %>">No.</a>
    <a class="linkQuote" title="Reply to this post" href="/<%= boardUri %>/<%= locals.isArchive ? 'archive/' : '' %>thread/<%= thread.threadId %>#q<%= reply.postId %>"><%= reply.postId %></a>
    <% if (modView) { %>
    <%- include('/mod/partials/post-links', { boardUri, thread, postId: reply.postId, isThread: false, post: reply, showIp, globalStaff }) %>
    <% } %>
    <div class="backlinks"></div>
    <% if (modView) { %>
    <%- include('/mod/partials/staff-info', { post: reply, showIp }) %>
    <% } %>
  </div>
  <div class="reply-content"><%
    const regExp = /<a\s+[^>]*href=["'](?:https?:\/\/(?:www\.)?youtube\.com\/watch\?v=|https?:\/\/youtu\.be\/)([a-zA-Z0-9_-]{11})(?:&[^"']*)?["'][^>]*>.*?<\/a>/gi;
    // vichan links to its own shape, relative or absolute (its `root` config),
    // e.g. /mmd/res/45.html#48 or https://39chan.moe/mmd/res/45.html#48.
    const boardLinkRegex = /href=["'](?:[^"']*?\/)?([\w-]+)\/res\/(\d+)\.html(?:#(\d+))?["']/gi;
    let parsedMSG = reply.markdown.replace(regExp, (match, videoId) => {
      let embedStr = `<details class="embed-container"><summary><a href="https://youtube.com/watch?v=${videoId}">https://youtube.com/watch?v=${videoId} </a><span class="format-summary">[Embed]</span></summary>`;
      embedStr += `<iframe style="margin-top: 3px" src="https://www.youtube.com/embed/${videoId}" frameborder="0"`;
      embedStr += `allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"`;
      embedStr += `referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe></details>`;
      return embedStr;
    });
    parsedMSG = parsedMSG.replace(boardLinkRegex, (match, board, threadId, post) => {
      const archivePrefix = locals.isArchive ? 'archive/' : '';
      return `href="/${board}/${archivePrefix}thread/${threadId}${post ? '#'+post : ''}"`;
    });
    if (locals.isArchive) {
      parsedMSG = parsedMSG.replace(/href=["']\/([\w-]+)\/thread\/(\d+)(?:#(\d+))?["']/gi, (match, board, threadId, postId) => {
        return `href="/${board}/archive/thread/${threadId}${postId ? '#'+postId : ''}"`;
      });
    }
  %><%- parsedMSG %><% if (reply.warningMessage) { %>
    <%- include('../partials/warning-message', { message: reply.warningMessage }) %>
    <% } else if (reply.banMessage) { %>
      <div class="ban-message">
        <%- reply.banMessage %> <img src="/img/ban.gif" width="60">
      </div>
    <% } %>
  </div>
</div>
