<%
// See cells/op.ejs: in the mod panel a link that opens the thread stays in the
// panel, while the number link stays public because that is where the reply form is.
var archivePrefix = locals.isArchive ? 'archive/' : '';
var href = '/' + boardUri + '/' + archivePrefix + 'thread/' + thread.threadId;
var threadHref = modView ? '/mod/thread/' + boardUri + '/' + thread.threadId : href;
var controls = modView || locals.modControls;
%>
<div class="post-container reply-container" id="pc<%= reply.postId %>">
<div class="side-arrows" id="sa<%= reply.postId %>"><% if (!modView) { %>&gt;&gt;<% } %></div>
<div class="post reply" id="p<%= reply.postId %>" data-post-id="<%= reply.postId %>" data-thread-id="<%= thread.threadId %>" data-board="<%= boardUri %>">
<div class="post-info" id="pi<%= reply.postId %>">
  <% if (!locals.isSearchResult) { %><input type="checkbox" class="<%= modView ? 'mod-select' : 'post-checkbox' %>" <% if (modView) { %>value="<%= boardUri %>-<%= thread.threadId %>-<%= reply.postId %>"<% } else { %>name="posts" form="delete-form" value="<%= reply.postId %>-false"<% } %>><% } %>
  <span class="name-block">
    <% const cap = locals.capcodeFor(reply.signedRole); %>
    <% if (cap) { %>
    <span<% if (cap.title) { %> title="<%= cap.title %>"<% } %> class="<%= cap.className %> name" data-capcode="<%= cap.text %>"><%- reply.name %><span class="capcode-label"> ## <%= cap.text %><% if (cap.icon) { %> <img src="<%= cap.icon %>"><% } %></span></span>
    <% } else { %>
    <span class="name" data-post-id="<%= reply.postId %>" data-board="<%= boardUri %>" data-thread-id="<%= thread.threadId %>"><%- reply.name %></span>
    <% } %>
  </span>
  <%- include('../partials/time', { date: reply.creation }) %> 
  <span class="post-num">
    <a class="linkQuote" title="Link to this post" href="<%= threadHref %>#<%= reply.postId %>">No.</a><a class="linkQuote" title="Reply to this post" href="<%= href %>#q<%= reply.postId %>"><%= reply.postId %></a>
  </span>
  <% if (controls) { %>
  <%- include('/mod/partials/post-links', { boardUri, thread, postId: reply.postId, isThread: false, post: reply, showIp, globalStaff }) %>
  <% } %>
  <div class="backlinks"></div>
  <% if (controls) { %>
  <%- include('/mod/partials/staff-info', { post: reply, showIp }) %>
  <% } %>
</div>
<% if (reply.files && reply.files.length > 0) { %>
<%- include('../partials/post-files', { files: reply.files, imageClass: 'reply-image', maxWidth: 150, maxHeight: 170, boardUri, threadId: thread.threadId, postId: reply.postId, modView }) %>
<% } %>
<% // YouTube / nicovideo / BiliBili links get an inline player and Twitter/X + Bluesky links are pointed at FxEmbed (be/lib/embeds.js).
   let parsedMSG = locals.expandMediaEmbeds(reply.markdown); const boardLinkRegex = /href=["'](?:[^"']*?\/)?([\w-]+)\/res\/(\d+)\.html(?:#(\d+))?["']/gi; parsedMSG = parsedMSG.replace(boardLinkRegex, function(match, board, threadId, post) { const archivePrefix = locals.isArchive ? 'archive/' : ''; return 'href="/' + board + '/' + archivePrefix + 'thread/' + threadId + (post ? '#'+post : '') + '"'; }); if (locals.isArchive) { parsedMSG = parsedMSG.replace(/href=["']\/([\w-]+)\/thread\/(\d+)(?:#(\d+))?["']/gi, function(match, board, threadId, postId) { return 'href="/' + board + '/archive/thread/' + threadId + (postId ? '#'+postId : '') + '"'; }); } %>
<blockquote class="reply-content" id="m<%= reply.postId %>"><%- parsedMSG %></blockquote>
<% if (reply.warningMessage) { %>
<%- include('../partials/warning-message', { message: reply.warningMessage }) %>
<% } else if (reply.banMessage) { %>
<div class="ban-message"><%- reply.banMessage %> <img src="/img/ban.gif" width="60"></div>
<% } %>
<% if (reply.poll) { %>
<%- include('poll', { poll: reply.poll }) %>
<% } %>
</div>
</div>
