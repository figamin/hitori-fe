<% title = '404 - Page Not Found'; %>
<style>
        body {
            margin: 0;
            padding: 0;
            background: #000;
            overflow: hidden;
            font-family: sans-serif;
        }

        .content {
            height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        .content img {
            max-width: 80%;
            max-height: 60vh;
        }
        .header {
          display: none;
        }
    </style>
    <audio id="rainAudio" autoplay loop>
        <source src="/sound/mikudayohymn.ogg" type="audio/ogg">
    </audio>

    <div class="content">
        <a href="/"><img src="/img/2Dayo.png" alt="Abyss"></a>
    </div>

    <script>
        const rainAudio = document.getElementById('rainAudio');
        rainAudio.play().catch(() => {
            document.addEventListener('click', () => {
                rainAudio.play();
            }, { once: true });
        });
    </script>