<form id="site-announcement-form">
<p>Site announcement (HTML, shown sitewide):</p>
<p><textarea name="announcement" rows="6" cols="60" maxlength="10000"><%= announcement || '' %></textarea></p>
<p>Max Length: 10000</p>
<p><button type="submit">Save announcement</button></p>
</form>
<form id="clear-ip-role-form">
<p>
Unhashed IPs visible to
<select name="clearIpMinRole">
<option value="0"<%= Number(clearIpMinRole) === 0 ? ' selected' : '' %>>Root</option>
<option value="1"<%= Number(clearIpMinRole) === 1 ? ' selected' : '' %>>Admin and above</option>
<option value="2"<%= Number(clearIpMinRole) === 2 ? ' selected' : '' %>>Moderator and above</option>
<option value="3"<%= Number(clearIpMinRole) === 3 ? ' selected' : '' %>>Janitor and above</option>
</select>
<button type="submit">Save</button>
</p>
</form>
<form id="captcha-global-form">
<p>
<label><input type="checkbox" name="enabled" value="true"<%= captcha && captcha.enabled ? ' checked' : '' %> />
Require a captcha before posting (all boards)</label>
<button type="submit">Save</button>
</p>
<p class="mod-hint">The picture, the character names and the ImageMagick settings live on
<a href="/mod/captcha">the captcha page</a>.</p>
</form>
