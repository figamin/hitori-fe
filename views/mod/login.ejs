<% title = 'Login'; %>
<div class="mod-login">
<h1>Moderation</h1>
<form id="mod-login-form">
<fieldset>
<legend>Staff Login</legend>
<% if (error) { %><p class="mod-error"><%= error %></p><% } %>
<table class="mod-settings">
<tr><th><label for="mod-login-name">Username</label></th><td><input type="text" id="mod-login-name" name="login" required maxlength="16" autocomplete="username"></td></tr>
<tr><th><label for="mod-login-password">Password</label></th><td><input type="password" id="mod-login-password" name="password" required autocomplete="current-password"></td></tr>
<tr><th></th><td><label><input type="checkbox" name="remember"> Remember me</label></td></tr>
</table>
<input type="hidden" name="redirect" value="<%= redirect %>">
<div class="mod-actions"><button type="submit">Login</button></div>
</fieldset>
</form>
</div>
