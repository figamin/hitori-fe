<% title = 'Board ' + board.boardUri; %>
<h1>/<%= board.boardUri %>/</h1>
<%- include('partials/board-nav') %>
<p><a href="/mod/board/<%= board.boardUri %>">Mod</a> / <a href="/<%= board.boardUri %>/">Public</a></p>

<h2>Board Settings</h2>
<% const s = board.settings || []; %>
<% if (canEditSettings) { %>
<form id="board-settings-form">
<input type="hidden" name="boardUri" value="<%= board.boardUri %>">
<p>Board Name: <input name="boardName" value="<%= board.boardName %>" maxlength="32" required></p>
<p>Board Description: <input name="boardDescription" value="<%= board.boardDescription %>" maxlength="128"></p>
<p>Tags: <input name="tags" value="<%= (board.tags || []).join(', ') %>"></p>
<p>Board Message: <input name="boardMessage" value="<%= board.boardMessage || '' %>" maxlength="256"></p>
<p>Max Length: 256</p>
<p>Bump Limit: <input name="autoSageLimit" type="number" min="0" value="<%= board.autoSageLimit || 0 %>"> replies</p>
<p>Maximum Bump Age: <input name="maxBumpAgeDays" type="number" min="0" value="<%= board.maxBumpAgeDays || 0 %>"> days</p>
<p>Thread Limit (Total): <input name="maxThreadCount" type="number" min="0" value="<%= board.maxThreadCount || 0 %>"> threads</p>
<p><label><input type="checkbox" name="archivePrunedThreads" value="1" <%= s.includes('archivePrunedThreads') ? 'checked' : '' %>> Archive threads bumped off the index</label></p>
<p>Thread Limit (Hourly): <input name="hourlyThreadLimit" type="number" min="0" value="<%= board.hourlyThreadLimit || 0 %>"> threads</p>
<p>Preferred Language: <input name="preferredLanguage" value="<%= board.preferredLanguage || 'en-us' %>"></p>
<p><label><input type="checkbox" name="textBoard" value="1" <%= s.includes('textBoard') ? 'checked' : '' %>> Textboard</label></p>
<p><label><input type="checkbox" name="unindex" value="1" <%= s.includes('unindex') ? 'checked' : '' %>> Hide board</label></p>

<h2>Posting</h2>
<p>Anonymous Name: <input name="anonymousName" value="<%= board.anonymousName || '' %>" maxlength="32" placeholder="<%= siteDefaultName || '' %>"> (blank uses site default)</p>
<p><label><input type="checkbox" name="forceAnonymity" value="1" <%= s.includes('forceAnonymity') ? 'checked' : '' %>> Forced Anonymity</label></p>
<p>Default message: <input name="defaultMessage" value="<%= board.defaultMessage || '' %>" maxlength="4096" placeholder="<%= siteDefaultMessage || '' %>"> (blank uses site default)</p>
<p>Maximum number of files per post: <input name="maxFiles" type="number" min="0" value="<%= board.maxFiles || 0 %>"> files (0 uses site default)</p>
<p>Maximum size per file: <input name="maxFileSizeMB" type="number" min="0" value="<%= board.maxFileSizeMB || 0 %>"> MB</p>
<p>Allowed file types: <input name="acceptedMimes" value="<%= (board.acceptedMimes || []).join(', ') %>"></p>
<p>
<label><input type="checkbox" name="disableIds" value="1" <%= s.includes('disableIds') ? 'checked' : '' %>> Disable IDs</label>
<label><input type="checkbox" name="requireThreadFile" value="1" <%= s.includes('requireThreadFile') ? 'checked' : '' %>> Require file for new threads</label>
<label><input type="checkbox" name="blockDeletion" value="1" <%= s.includes('blockDeletion') ? 'checked' : '' %>> Disable User Self-Deletion</label>
<label><input type="checkbox" name="disablePolls" value="1" <%= s.includes('disablePolls') ? 'checked' : '' %>> Disable polls</label>
<label><input type="checkbox" name="disableYoutube" value="1" <%= s.includes('disableYoutube') ? 'checked' : '' %>> Disable Video Embeds (YouTube, Nicovideo, BiliBili, Twitter/X, Bluesky)</label>
<label><input type="checkbox" name="disableTegaki" value="1" <%= s.includes('disableTegaki') ? 'checked' : '' %>> Disable Tegaki</label>
</p>
<button type="submit">Save</button>
</form>
<% } else { %>
<p>Owner: <%= board.owner %> /Moderators: <%= (board.volunteers || []).join(', ') || 'none' %></p>
<% } %>

<% if (isOwner || isAdmin) { %>
<h2>Moderators</h2>
<form id="volunteer-form">
<input type="hidden" name="boardUri" value="<%= board.boardUri %>">
<input name="login" placeholder="Moderator">
<button type="submit" name="add" value="1">Add</button>
<button type="submit" name="add" value="0">Remove</button>
</form>
<% } %>

<h2>Filters</h2>
<form id="filter-form">
<input type="hidden" name="boardUri" value="<%= board.boardUri %>">
<input name="originalTerm" placeholder="Term" required>
<input name="replacementTerm" placeholder="Replacement" required>
<label><input type="checkbox" name="caseInsensitive" value="1"> i</label>
<button type="submit">Add</button>
</form>
<ul>
<% filters.forEach(f => { %>
<li><%= f.originalTerm %> → <%= f.replacementTerm %> <button type="button" class="delete-filter" data-id="<%= f._id %>">Delete</button></li>
<% }) %>
</ul>
