<% title = 'Global Banners'; %>
<form id="banner-upload-form" enctype="multipart/form-data">
<input type="file" name="banners" accept="image/jpeg,image/png,image/gif,image/webp" multiple required>
<button type="submit">Upload</button>
<span id="banner-upload-status" class="file-info"></span>
</form>
<p class="file-info">Select one or more images at once. File names are kept as-is; a number is appended if a banner with that name already exists.</p>
<% banners.forEach(b => { %>
<p>
<img src="<%= b.filename %>" alt=""><br>
<%= b.filename.replace('/.global/banners/', '') %>
<button type="button" class="delete-banner" data-id="<%= b._id %>">Delete</button>
</p>
<% }) %>
<% if (!banners.length) { %><p>None</p><% } %>
