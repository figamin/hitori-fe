<% title = 'ASN Bans'; %>
<%- include('partials/board-nav') %>
<p><a href="/mod/bans<%= boardUri ? '?board=' + boardUri : '' %>">Bans</a></p>
<form id="asn-ban-form">
<% if (boardUri) { %><input type="hidden" name="boardUri" value="<%= boardUri %>"><% } else { %><input name="boardUri" placeholder="Board"><% } %>
<input name="asn" placeholder="ASN" required>
<input name="reason" placeholder="Reason" required>
<input name="duration" value="5y" title="Ban length: 30s, 10m, 6h, 3d, 2w, 5y">
<button type="submit">Ban</button>
</form>
<table class="mod-table">
<tr><th>ASN</th><th>Board</th><th>Reason</th><th>By</th><th></th></tr>
<% bans.forEach(b => { %>
<tr>
<td><%= b.asn %></td>
<td><% if (b.boardUri) { %>/<%= b.boardUri %>/<% } else { %>global<% } %></td>
<td><%= b.reason %></td>
<td><%= b.appliedBy || '' %></td>
<td><button type="button" class="lift-ban" data-id="<%= b._id %>">Lift</button></td>
</tr>
<% }) %>
</table>
