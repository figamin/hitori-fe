            <div class="box" data-collapse-key="featured">
                <div class="box-title box-title-flex">
                    <span>FEATURED THREADS</span>
                    <button class="collapse-toggle collapse-toggle--mobile" aria-expanded="true" aria-label="Toggle section">&minus;</button>
                </div>
                <div class="featured collapsible">
                    <%
                    // Which threads are up here is an editorial list, edited at /mod/featured
                    // from any thread on any board; the table behind it is
                    // `koshi_featured_threads` and the order is the order of the cards.
                    //
                    // The box is four cards wide and is never narrower than four. The panel
                    // keeps the list at four or more, but a featured thread can be deleted
                    // after it was picked, so a gap is filled from this snapshot's busiest
                    // threads instead of the box drawing three cards.
                    var featured = (featuredThreads || []).filter(function (t) { return t.exists; });
                    var featuredKeys = {};
                    featured.forEach(function (t) { featuredKeys[t.boardUri + '/' + t.threadId] = true; });
                    (activeThreads || []).forEach(function (t) {
                      if (featured.length >= 4) return;
                      var key = t.boardUri + '/' + t.threadId;
                      if (featuredKeys[key]) return;
                      featuredKeys[key] = true;
                      featured.push({
                        boardUri: t.boardUri,
                        boardName: t.boardName,
                        threadId: t.threadId,
                        title: t.subject || postSnippet(t.message, 100),
                        thumb: t.files && t.files.length ? t.files[0].thumb : null
                      });
                    });
                    %>
                    <% featured.slice(0, 4).forEach(function (thread) { %>
                    <a href="/<%= thread.boardUri %>/thread/<%= thread.threadId %>" class="item">
                        <div class="fthumb">
                            <% if (thread.thumb) { %><img src="<%= thread.thumb %>" alt="Thread thumbnail" loading="lazy"><% } %>
                            <span class="star">&#9733;</span>
                        </div>
                        <div class="meta">
                            <div class="ftitle"><%= thread.title || 'No subject' %></div>
                            <div class="fboard"><%= thread.boardName || thread.boardUri %></div>
                        </div>
                    </a>
                    <% }); %>
                </div>
            </div>

            <% boardSections.forEach(function (section) { %>
            <div class="box" data-collapse-key="<%= section.key %>">
                <div class="box-title box-title-flex box-title-alt">
                    <h2><%= section.title %></h2>
                    <% if (section.actions) { %>
                    <div class="title-actions">
                        <a href="/all/" class="btn-accent" id="viewAllPosts">View All Posts</a>
                        <button class="btn-accent" id="toggleNsfw">Hide NSFW Boards</button>
                        <button class="collapse-toggle collapse-toggle--mobile" aria-expanded="true" aria-label="Toggle section">&minus;</button>
                    </div>
                    <% } else { %>
                    <button class="collapse-toggle collapse-toggle--mobile" aria-expanded="true" aria-label="Toggle section">&minus;</button>
                    <% } %>
                </div>
                <div class="collapsible">
                    <% section.boards.forEach(function (b) { %>
                    <% var lt = boardLatest(b.uri); %>
                    <div class="board<%= b.nsfw ? ' nsfw' : '' %>" data-href="/<%= b.uri %>/" tabindex="0" role="link">
                        <div class="info">
                            <h3><a href="/<%= b.uri %>/"><%= b.name %></a><% if (b.nsfw) { %> <span class="badge">NSFW</span><% } %></h3>
                            <p><%= b.desc %></p>
                        </div>
                        <div class="recent">
                            <div class="time"><img src="/items/icons/notif.png" alt="icon"> <% var ltTs = boardBump(b.uri); %><% if (ltTs) { %><span class="board-time" data-ts="<%= ltTs %>"><%= boardTimeLabel(ltTs) %></span><% } else { %>No posts yet<% } %></div>
                            <div class="topic">In: <% if (lt) { %><a href="/<%= b.uri %>/thread/<%= lt.threadId %>"><%= lt.subject || postSnippet(lt.message, 30) || 'No subject' %></a><% } else { %>&mdash;<% } %></div>
                        </div>
                        <div class="chan-board-icon"><img src="/items/icons/<%= b.icon %>" alt="Icon"></div>
                    </div>
                    <% }); %>
                </div>
            </div>
            <% }); %>

            <div class="activity">
                <div class="box chan-activity-col">
                    <div class="box-title">RECENT POSTS</div>
                    <div class="box-body posts">
                        <% (latestPosts || []).slice(0, 17).forEach(function (post) { %>
                        <div class="line"><a href="/<%= post.boardUri %>/" class="pboard"><%= boardLabel(post.boardUri) %></a> - <span class="snippet"><a href="<%= postUrl(post) %>" class="snippet-link"><%- post.message || 'No message' %></a></span></div>
                        <% }); %>
                    </div>
                </div>

                <div class="box chan-activity-col">
                    <div class="box-title">ACTIVE THREADS</div>
                    <div class="box-body threads">
                        <% (activeThreads || []).slice(0, 8).forEach(function (thread) { %>
                        <a href="/<%= thread.boardUri %>/thread/<%= thread.threadId %>" class="thread">
                            <div class="tthumb"><% if (thread.files && thread.files.length > 0) { %><img src="<%= thread.files[0].thumb %>" alt="Thread thumbnail"><% } %></div>
                            <div class="chan-active-thread-info">
                                <div class="tboard"><%= thread.boardName %></div>
                                <div class="ttitle"><%- thread.subject || thread.message || 'No subject' %></div>
                                <div class="tmeta"><%= thread.postCount %> replies &bull; <span class="relative-time" data-ts="<%= new Date(thread.lastBump).getTime() %>"><%= activeTimeLabel(new Date(thread.lastBump).getTime()) %></span></div>
                            </div>
                        </a>
                        <% }); %>
                    </div>
                </div>
            </div>

            <div class="box">
                <div class="box-title box-title-alt">
                    <h2>RECENT IMAGES</h2>
                </div>
                <div class="gallery">
                    <div class="scroll" id="scroller">
                        <% (latestImages || []).slice(0, 24).forEach(function (image) { %>
                        <a href="<%= postUrl(image) %>"><img src="<%= image.thumb %>" alt="Small thumbnail" loading="lazy"></a>
                        <% }); %>
                    </div>
                </div>
            </div>

        </main>

