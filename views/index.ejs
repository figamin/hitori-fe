<%
var displayName = siteName ? siteName.charAt(0).toUpperCase() + siteName.slice(1) : 'Wapchan';
var rawBoards = (boards || []);
var allBoardList = (allBoards || []);
var boardMap = {};
var boardNames = {};

rawBoards.forEach(function (b) { boardMap[b.boardUri] = b; });
allBoardList.forEach(function (b) { boardNames[b.boardUri] = b.boardName; });
rawBoards.forEach(function (b) { boardNames[b.boardUri] = b.boardName; });

function boardExists(uri) {
  return Boolean(boardMap[uri] || boardNames[uri]);
}

function boardNameFor(uri, fallback) {
  return (boardMap[uri] && boardMap[uri].boardName) || boardNames[uri] || fallback;
}

function boardDescriptionFor(uri, fallback) {
  return (boardMap[uri] && boardMap[uri].boardDescription) || fallback;
}

function formatNumber(n) {
  var value = Number(n);
  return isFinite(value) ? value.toLocaleString('en-US') : '0';
}

function boardStats(uri) {
  var b = boardMap[uri];
  if (!b) return '';
  var threads = Number(b.threadCount);
  var posts = Number(b.lastPostId);
  if (!isFinite(threads) && !isFinite(posts)) return '';
  return 'T: ' + (isFinite(threads) ? formatNumber(threads) : '?') +
    ' / P: ' + (isFinite(posts) ? formatNumber(posts) : '?');
}

function postSnippet(text, len) {
  var s = String(text == null ? '' : text)
    .replace(/<br\s*\/?>/gi, ' ')
    .replace(/\[\/?[a-zA-Z0-9*]+\]/g, '')
    .replace(/<[^>]*>/g, ' ')
    .replace(/&nbsp;/g, ' ')
    .replace(/&amp;/g, '&')
    .replace(/\s+/g, ' ')
    .trim();
  return s.length > len ? s.slice(0, len).trim() + '…' : s;
}

function timeAgo(ts) {
  if (!ts) return 'Just now';
  var diff = Math.max(0, Math.floor((Date.now() - ts) / 1000));
  var days = Math.floor(diff / 86400);
  var hours = Math.floor((diff % 86400) / 3600);
  var minutes = Math.floor((diff % 3600) / 60);
  var parts = [];
  if (days > 0) parts.push(days + ' day' + (days === 1 ? '' : 's'));
  if (hours > 0) parts.push(hours + ' hour' + (hours === 1 ? '' : 's'));
  if (minutes > 0) parts.push(minutes + ' minute' + (minutes === 1 ? '' : 's'));
  return parts.length ? parts.join(', ') + ' ago' : 'Just now';
}

function postUrl(post) {
  return '/' + post.boardUri + '/thread/' + post.threadId + (post.isThread ? '' : '#' + post.postId);
}

var newsList = Array.isArray(latestNews) ? latestNews.slice(0, 4) : (latestNews ? [latestNews] : []);

var boardSections = [
  {
    title: 'Otaku Channels',
    boards: [
      { uri: 'cel', name: 'Retro Anime & Manga', desc: "It's like rec.arts.anime, only with images!" },
      { uri: 'digi', name: 'Post 2K Anime & Manga', desc: "Say, looks like you're on the Internet! Which means you're on the Internet. Forget I asked." },
      { uri: 'lum', name: 'Rumic World', desc: "I don't think about that and neither should you." },
      { uri: 'vnt', name: 'Retro Vidya & Tech', desc: 'Beep boop son, beep boop.' },
      { uri: 'djn', name: 'Doujin Culture & VNs', desc: 'Your virtual Comic Party!' },
      { uri: 'art', name: 'The Artboard (Oekaki)', desc: 'Art is a sport!' }
    ]
  },
  {
    title: 'General Discussion',
    boards: [
      { uri: 'sp', name: 'Sports', desc: "The breakfast of champions! (Threads won't show up under the overboard)." },
      { uri: 'kind', name: 'Acts of Kindness', desc: 'No Bully! Help Others!' },
      { uri: 'lit', name: 'Literature', desc: "Wapchan's greatest battleground." },
      { uri: 'co', name: 'Comics & Cartoons', desc: "It's all western." },
      { uri: 'media', name: 'Mixed Media', desc: 'For all you aspiring disk jockeys and kinography experts.' },
      { uri: 'gens', name: 'Generals', desc: 'For everything else.' },
      { uri: 'wap', name: 'On-site Discussion', desc: 'File your complaints with upper management.' }
    ]
  }
];

var visibleSections = boardSections.map(function (section) {
  return {
    title: section.title,
    boards: section.boards.filter(function (b) { return boardExists(b.uri); })
  };
}).filter(function (section) { return section.boards.length > 0; });
%>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= displayName %></title>

    <meta name="description" content="We're a forum centered around discussion of pre 2000s anime &amp; manga with a particular focus on the works of Rumiko Takahashi, though we have many other topics as well.">
    <meta name="keywords" content="anime, manga, gaming, forum, imageboard, urusei yatsura, ranma, touhou, rumiko takahashi">
    <meta name="author" content="<%= displayName %>">

    <meta property="og:type" content="website">
    <meta property="og:title" content="<%= displayName %>">
    <meta property="og:site_name" content="<%= displayName %>">
    <meta property="og:description" content="We're a forum centered around discussion of pre 2000s anime &amp; manga with a particular focus on the works of Rumiko Takahashi, though we have many other topics as well.">
    <meta property="og:image" content="<%= siteUrl %>/home/mascot.png">
    <meta property="og:url" content="<%= siteUrl %>/">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= displayName %>">
    <meta name="twitter:description" content="We're a forum centered around discussion of pre 2000s anime &amp; manga with a particular focus on the works of Rumiko Takahashi, though we have many other topics as well.">
    <meta name="twitter:image" content="<%= siteUrl %>/home/mascot.png">

    <link rel="shortcut icon" href="/home/favicon.ico">
    <link rel="stylesheet" href="/home.css?v=<%= locals.assetVersion('home.css') %>">
</head>
<body>

<div class="container">
    <div class="sidebar">

        <div class="forum-section">
            <div class="tv">
                <div class="antenna left"></div>
                <div class="antenna right"></div>
                <div class="screen">
                    <img src="/home/mascot.png" alt="CRT content">
                    <div class="scanlines"></div>
                    <div class="glow"></div>
                </div>
                <div class="controls">
                    <div class="tv-label">
                        <div class="logo">
                            <a href="/"><img src="/home/logo.png" alt="<%= displayName %>"></a>
                        </div>
                    </div>
                    <div class="dial-group">
                        <div class="dial"></div>
                        <div class="dial"></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="sidebar-section">
            <div class="section-header">Radio</div>
            <div class="sidebar-content">
                <a class="radio-link" href="https://radio.wapchan.org/" target="_blank" rel="noopener">&#9654; Listen to WAPFM</a>
            </div>
        </div>

        <% visibleSections.forEach(function (section) { %>
        <div class="forum-section">
            <div class="section-header"><%= section.title %></div>
            <% section.boards.forEach(function (b) { %>
            <a href="/<%= b.uri %>/" class="forum-title forum-row" title="<%= boardDescriptionFor(b.uri, b.desc) %>">
                <img class="pixel" src="/home/icons/<%= b.uri %>.png" alt="" width="16" height="16">
                <div class="holder">
                    <div class="forum-info"><%= boardNameFor(b.uri, b.name) %></div>
                    <% var stats = boardStats(b.uri); %>
                    <% if (stats) { %><div class="forum-stats"><%= stats %></div><% } %>
                </div>
            </a>
            <% }); %>
        </div>
        <% }); %>

        <div class="forum-section">
            <div class="section-header">Net Friends</div>
            <div class="sidebar-content">
                <ul id="friends">
                    <li><a href="https://kissu.moe"><img src="/home/friends/kissu.gif" alt="Kissu"></a></li>
                    <li><a href="https://hikari3.ch"><img src="/home/friends/hikari3.gif" alt="Hikari3"></a></li>
                    <li><a href="https://39chan.moe"><img src="/home/friends/39chan.gif" alt="39chan"></a></li>
                    <li><a href="https://sheepishpatio.net"><img src="/home/friends/sheepishpatio.png" alt="SheepishPatio"></a></li>
                    <li><a href="https://marzichan.org"><img src="/home/friends/marzichan.png" alt="Marzichan"></a></li>
                    <li><a href="https://holotower.org"><img src="/home/friends/holotower.png" alt="Holotower"></a></li>
                </ul>
            </div>
        </div>

    </div>

    <div class="main-content">

        <div class="about-section">
            <div class="about-content">
                <div class="about-text">
                    <div class="nav-tabs" id="navTabs">
                        <a href="/" class="nav-tab active">Home</a>
                        <a href="/rules" class="nav-tab">Rules</a>
                        <a href="/news" class="nav-tab">News</a>
                        <a href="/all/" class="nav-tab">Overboard</a>
                        <a href="/faq" class="nav-tab">FAQ</a>
                    </div>

                    <p class="about-title">Welcome to <span style="color: #fd0;"><%= displayName %></span>!</p>
                    <p>(short for <a href="https://www.urbandictionary.com/define.php?term=Wapanese">Wapanese</a> Channel).</p>
                    <p>We're a forum centered around discussion of pre 2000s anime &amp; manga with a particular focus on the works of Rumiko Takahashi, though we have many other topics as well. We've been running since New Year's 2022, so tune in to whatever channel interests you and start posting!</p>
                    <br>
                    <p>Read the <a href="/rules">Rules</a> before posting, and for site information check out the <a href="/faq">FAQ</a>.</p>

                    <p id="randomQuote"><i>Javascript...</i></p>
                </div>

                <div class="sidebar">
                    <div class="sidebar-section">
                        <div class="section-header">Statistics</div>
                        <div class="sidebar-content">
                            <div class="online-users">
                                <span class="online-count"><%= formatNumber(siteStats.totalPosts) %></span> Total Posts<br>
                                <span class="online-count"><%= formatNumber(siteStats.totalUniquePosters) %></span> Unique Users<br>
                                <span class="online-count"><%= siteStats.totalMediaSize %></span> GB Storage Used<br>
                                <span class="online-count"><%= formatNumber(siteStats.usersOnline) %></span> Users Online Now
                            </div>
                        </div>
                    </div>

                    <% if (newsList.length > 0) { %>
                    <div class="sidebar-section">
                        <div class="section-header">What's New?</div>
                        <div class="sidebar-content">
                            <% newsList.forEach(function (article) { %>
                            <div class="article">
                                <h2>
                                    <a href="/news<%= article.newsId != null ? '#' + article.newsId : '' %>"><%= article.title %></a>
                                    <span class="unimportant">&mdash; by <%= article.author %> at <%= new Date(article.date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) %></span>
                                </h2>
                            </div>
                            <% }); %>
                        </div>
                    </div>
                    <% } %>
                </div>
            </div>
        </div>

        <% if ((activeThreads || []).length > 0) { %>
        <div class="box-header">Active Threads</div>
        <div class="active-threads-list">
            <% (activeThreads || []).slice(0, 12).forEach(function (thread) { %>
            <% var thumb = thread.files && thread.files.length ? thread.files[0].thumb : '/genericThumb.webp'; %>
            <% var ts = new Date(thread.lastBump).getTime(); %>
            <a href="/<%= thread.boardUri %>/thread/<%= thread.threadId %>" class="thread-title">
                <article class="thread-preview">
                    <span class="post-board"><%= boardNameFor(thread.boardUri, thread.boardName || thread.boardUri) %></span>
                    <img src="<%= thumb %>" alt="Thread thumbnail" loading="lazy" decoding="async">
                    <div class="thread-meta">
                        <span><%= unescapeHtml(thread.subject || postSnippet(thread.message, 100)) || 'No subject' %></span>
                        <small>
                            <%= Number(thread.postCount || 0) %> replies &bull;
                            <span class="time-ago" data-timestamp="<%= Math.floor(ts / 1000) %>"><%= timeAgo(ts) %></span>
                        </small>
                    </div>
                </article>
            </a>
            <% }); %>
        </div>
        <% } %>

        <% if ((latestImages || []).length > 0) { %>
        <div class="recent-images">
            <div class="section-header">Recent Images</div>
            <div class="gallery-container">
                <button type="button" class="gallery-nav gallery-prev" data-gallery="-1" aria-label="Previous images">&#8249;</button>
                <div class="gallery-scroll" id="galleryScroll">
                    <% (latestImages || []).slice(0, 24).forEach(function (image) { %>
                    <div class="image-item">
                        <a href="<%= postUrl(image) %>"><img src="<%= image.thumb %>" alt="Recent art" loading="lazy" decoding="async"></a>
                    </div>
                    <% }); %>
                </div>
                <button type="button" class="gallery-nav gallery-next" data-gallery="1" aria-label="Next images">&#8250;</button>
            </div>
        </div>
        <% } %>

    </div>
</div>

<footer class="footer">
    <div class="footer-content">
        <div class="footer-links">
            <a href="/news">News</a>
            <a href="/rules">Rules</a>
            <a href="/faq">FAQ</a>
            <a href="/linkus">Link Us</a>
            <a href="/rss.xml">RSS</a>
            <a href="/contact">Contact</a>
        </div>
        <div class="footer-copyright">
            &copy; <%= new Date().getFullYear() %> <%= displayName %>. All rights reserved. &bull; Powered by hitori/koshi
        </div>
    </div>
</footer>

<script src="/home.js?v=<%= locals.assetVersion('home.js') %>"></script>
</body>
</html>
