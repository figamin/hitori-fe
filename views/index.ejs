<%
var boardMap = {};
(boards || []).forEach(function (b) { boardMap[b.boardUri] = b; });

var bumpMap = {};
(activeThreads || []).forEach(function (t) {
  var ts = new Date(t.lastBump).getTime();
  if (!bumpMap[t.boardUri] || ts > bumpMap[t.boardUri]) bumpMap[t.boardUri] = ts;
});

function boardLatest(uri) {
  var b = boardMap[uri];
  return b && b.recentThreads && b.recentThreads.length ? b.recentThreads[0] : null;
}

function boardBump(uri) {
  var lt = boardLatest(uri);
  if (lt && lt.lastBump) {
    var ts = new Date(lt.lastBump).getTime();
    if (!isNaN(ts)) return ts;
  }
  return bumpMap[uri] || 0;
}

function boardLabel(uri) {
  return boardMap[uri] && boardMap[uri].boardName ? boardMap[uri].boardName : uri;
}

function postSnippet(text, len) {
  var s = String(text == null ? '' : text)
    .replace(/<br\s*\/?>/gi, ' ')
    .replace(/\[\/?[a-zA-Z0-9*]+\]/g, '')
    .replace(/<[^>]*>/g, ' ')
    .replace(/&nbsp;/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();
  return s.length > len ? s.slice(0, len).trim() + '…' : s;
}

function boardTimeLabel(ts) {
  if (!ts) return '';
  var diffMin = Math.floor((Date.now() - ts) / 60000);
  if (diffMin < 1) return 'Just now';

  var d = new Date(ts);
  var now = new Date();
  var timeStr = d.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', hour12: true });
  var startOfToday = new Date(now.getFullYear(), now.getMonth(), now.getDate());
  var startOfThat = new Date(d.getFullYear(), d.getMonth(), d.getDate());
  var dayDiff = Math.round((startOfToday - startOfThat) / 86400000);

  if (dayDiff === 0) return 'Today, ' + timeStr;
  if (dayDiff === 1) return 'Yesterday, ' + timeStr;
  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) + ', ' + timeStr;
}

function activeTimeLabel(ts) {
  if (!ts) return '';
  var diffMin = Math.floor((Date.now() - ts) / 60000);
  if (diffMin < 1) return 'Just now';
  if (diffMin < 60) return diffMin + ' minute' + (diffMin === 1 ? '' : 's') + ' ago';

  var hours = Math.floor(diffMin / 60);
  var mins = diffMin % 60;
  if (hours < 24) {
    var hourStr = hours + ' hour' + (hours === 1 ? '' : 's');
    return mins === 0 ? hourStr + ' ago' : hourStr + ', ' + mins + ' minute' + (mins === 1 ? '' : 's') + ' ago';
  }

  var days = Math.floor(hours / 24);
  if (days < 30) return days + ' day' + (days === 1 ? '' : 's') + ' ago';

  var months = Math.floor(days / 30);
  if (months < 12) return months + ' month' + (months === 1 ? '' : 's') + ' ago';

  var years = Math.floor(months / 12);
  return years + ' year' + (years === 1 ? '' : 's') + ' ago';
}

function postUrl(post) {
  return '/' + post.boardUri + '/thread/' + post.threadId + (post.isThread ? '' : '#' + post.postId);
}

var newsList = Array.isArray(latestNews) ? latestNews.slice(0, 4) : (latestNews ? [latestNews] : []);

var boardSections = [
  {
    key: 'vocal-synths',
    title: 'VOCAL-SYNTHS',
    actions: true,
    boards: [
      { uri: 'leek', name: 'Vocaloid Lounge', icon: '1.png', nsfw: false, desc: 'Your go-to board for all things Vocaloid, covering fandom, music, culture, and other related topics.' },
      { uri: 'negi', name: 'ボーカロイド・ラウンジ', icon: '10.png', nsfw: false, desc: '日本語版の/leek/。Vocaloidに関するあらゆる話題を扱う掲示板です。' },
      { uri: 'mmd', name: 'MikuMikuDance', icon: '2.png', nsfw: true, desc: 'A board for discussing MikuMikuDance and other software for creating anime-style 3D computer graphics.' },
      { uri: 'live', name: 'Vocaloid Live Events', icon: '3.png', nsfw: false, desc: 'This board is dedicated to discussions about Vocaloid-related events, including concerts, meetups, etc.' }
    ]
  },
  {
    key: 'artwork',
    title: 'ARTWORK',
    actions: false,
    boards: [
      { uri: 'c', name: 'Vocaloid/Cute', icon: '4.png', nsfw: false, desc: 'An image-sharing board dedicated to cute Vocaloid images, guaranteed to make you say “Aww”.' },
      { uri: 'o', name: 'Art / Oekaki', icon: '6.png', nsfw: true, desc: 'Share your Vocaloid themed artwork with the community, fulfill requests, or simply enjoy the creative works of others.' }
    ]
  },
  {
    key: 'off-topic',
    title: 'OFF-TOPIC',
    actions: false,
    boards: [
      { uri: 'g', name: 'General Discussion', icon: '7.png', nsfw: false, desc: "39chan's 'everything else' section. For any topics that don't belong in the other boards." },
      { uri: 'j', name: 'Japanese Culture', icon: '8.png', nsfw: false, desc: 'A board for the discussion of Japanese topics, including Otaku hobbies. (Note: Political content is banned.)' },
      { uri: 'meta', name: 'Site Discussion', icon: '9.png', nsfw: false, desc: 'Got any questions or complaints? You can use this board to yell at us in our faces.' }
    ]
  }
];
%>
<!DOCTYPE html>
<html lang="en">
